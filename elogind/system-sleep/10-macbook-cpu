#!/bin/sh
# elogind system-sleep hook: offline secondary CPUs around suspend.
#
# Workaround for MacBookPro11,5 (Void Linux, radeon, S3/deep sleep):
# restoring secondary CPUs during early S3 resume stalls for ~20s.
# Offlining them before suspend and onlining them after resume keeps
# wake time at ~6-7s.
#
# elogind calls this script twice per sleep cycle:
#   <script> pre  suspend|hibernate   (before /sys/power/state is written)
#   <script> post suspend|hibernate  (after resume)
# Hooks run as root. State is kept in /run (tmpfs) so a stale file
# cannot survive a reboot.

STATE=/run/elogind-macbook-cpu-offline.state
LOG_TAG=elogind-cpu-hook

log() { logger -t "$LOG_TAG" -- "$1" 2>/dev/null || echo "$LOG_TAG: $1" >&2; }

case "$1" in
pre)
    # A leftover state file means the post hook never ran; do not
    # offline twice or overwrite the record of what needs restoring.
    if [ -e "$STATE" ]; then
        log "stale state file $STATE present, skipping"
        exit 0
    fi

    # Collect currently online secondary CPUs (cpu0 has no online file).
    cpus=""
    for f in /sys/devices/system/cpu/cpu[1-9]*/online; do
        [ -f "$f" ] || continue
        [ "$(cat "$f" 2>/dev/null)" = "1" ] || continue
        cpu=${f%/online}
        cpu=${cpu##*/cpu}
        cpus="$cpus $cpu"
    done

    # Nothing to offline (single-CPU state): nothing to record.
    [ -n "$cpus" ] || exit 0

    # Record first, offline second: if a single offline write fails the
    # post hook still knows everything that was taken down.
    printf '%s\n' $cpus > "$STATE.tmp" && mv "$STATE.tmp" "$STATE" || {
        log "could not write state file $STATE, aborting"
        exit 0
    }

    for cpu in $cpus; do
        if ! echo 0 > "/sys/devices/system/cpu/cpu$cpu/online" 2>/dev/null; then
            log "failed to offline cpu$cpu"
        fi
    done

    log "offlined CPUs:$cpus"
    ;;
post)
    # No state file: pre hook did not offline anything, or the machine
    # rebooted since. Nothing to do.
    if [ ! -f "$STATE" ]; then
        exit 0
    fi

    failed=0
    for cpu in $(cat "$STATE"); do
        f=/sys/devices/system/cpu/cpu$cpu/online
        if [ ! -f "$f" ]; then
            log "cpu$cpu online sysfs file missing"
            failed=1
            continue
        fi
        if ! echo 1 > "$f" 2>/dev/null; then
            log "failed to online cpu$cpu"
            failed=1
        fi
    done

    rm -f "$STATE"

    if [ "$failed" = 0 ]; then
        log "restored CPUs"
    else
        log "finished with errors, check $(cat /sys/devices/system/cpu/online 2>/dev/null)"
    fi
    ;;
esac

exit 0
